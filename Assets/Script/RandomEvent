using UnityEngine;

public class RandomEvent : MonoBehaviour
{
    public int TrashCoolDownTimer;
    public int TrashCoolDown;
    public string TrashBox;

    private TimeTracker Timer;

    private int TrashCount;

    void Awake()
    {
        UpdateText();
        TrashCoolDownTimer = Random.Range(-5,0);
    }

    void Update()
    {
        TrashCoolDownTimer+= Time.deltaTime;

        if (TrashCoolDownTimer >= TrashCoolDown)
        {
            Trash();
            TrashCoolDownTimer = Random.Range(-5,0);
        }    
    }

    private void UpdateText()
    {
        TrashBox = "I placed " + TrashCount + " trash!"; 
    }

    private void Trash()
    {
        Luck = UnityEngine.Random.Range(1, 15);

        if(Luck == 14)
        {
            Timer.SpawnTrash();
            TrashCount++;
            UpdateText();
        }
    }
}

